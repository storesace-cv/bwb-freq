#!/usr/bin/env python3
"""Launcher script for the requisitions Qt GUI with automatic requirements check."""

from __future__ import annotations

import importlib.util
import subprocess
import sys
import pathlib


def _ensure_requirements_installed() -> None:
    """Ensure all requirements from requirements.txt are installed."""

    root = pathlib.Path(__file__).resolve().parent
    req_file = root / "requirements.txt"
    if not req_file.exists():
        return

    requirements: list[str]
    try:
        import pkg_resources
    except ModuleNotFoundError:
        print(
            "⚠️ pkg_resources is unavailable — installing requirements directly.",
            file=sys.stderr,
        )
    else:
        with req_file.open("r", encoding="utf-8") as f:
            requirements = [
                line.strip()
                for line in f
                if line.strip() and not line.strip().startswith("#")
            ]

        try:
            pkg_resources.require(requirements)
        except (pkg_resources.DistributionNotFound, pkg_resources.VersionConflict):
            print(
                "📦 Requirements missing or outdated — installing...",
                file=sys.stderr,
            )
        except Exception as exc:  # pragma: no cover - defensive path
            print(
                f"⚠️ Could not verify requirements ({exc!s}) — installing anyway.",
                file=sys.stderr,
            )
        else:
            return

    subprocess.run([sys.executable, "-m", "pip", "install", "-r", str(req_file)], check=True)


def _ensure_qt_is_installed() -> None:
    """Exit early with guidance if PySide6 is missing."""
    if importlib.util.find_spec("PySide6") is not None:
        return
    message = "\n".join(
        [
            "PySide6 is required to launch the requisitions GUI but was not found.",
            "Install the project's dependencies with one of the following commands:",
            "  pip install -r requirements.txt",
            "  poetry install",
        ]
    )
    print(message, file=sys.stderr)
    raise SystemExit(1)


# ---------------------------------------------------------------------
# Main sequence
# ---------------------------------------------------------------------

_ensure_requirements_installed()
_ensure_qt_is_installed()

from app.ui.app import main

if __name__ == "__main__":
    raise SystemExit(main())
